# Copy to .env for live spreadsheet capture. Never commit .env.
# Not needed for normal editorial work: committed snapshots in data/source/ work offline.
# The spreadsheet ID lives in config/sources.yaml.

# OAuth 2.0 access token with the read-only Sheets scope
# (https://www.googleapis.com/auth/spreadsheets.readonly), used by:
#   python3 scripts/import_sheet.py --fetch api
GOOGLE_OAUTH_ACCESS_TOKEN=

# Alternative: an API key. Works only if the sheet is shared "anyone with the link can view".
GOOGLE_API_KEY=
