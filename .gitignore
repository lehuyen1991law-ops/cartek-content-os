*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.aac
*.psd
*.prproj
*.aep
*.drp
assets/raw/

# --- Local scratch ------------------------------------------------------------
scratch/
tmp/
