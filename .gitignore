# --- Secrets and credentials: never commit -------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*.json
*service-account*.json
client_secret*.json
token*.json

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# --- Editors / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Generated drafts (approved release packages ARE committed) ------------
content/**/exports/*.draft.json

# --- Raw media and production project files: keep outside Git --------------
