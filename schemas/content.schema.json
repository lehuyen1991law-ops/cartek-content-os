{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lehuyen1991law-ops/cartek-content-os/schemas/content.schema.json",
  "title": "Cartek content record (item.yaml)",
  "description": "One long-form video or Short. Vocabulary membership (pillars, personas, video types, source types, safety flags) is checked by scripts/validate_content.py against config/ and data/normalized/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "format",
    "test_item",
    "working_title",
    "language",
    "pillar",
    "video_type",
    "audience",
    "search_intent",
    "keywords",
    "vehicle",
    "problem",
    "takeaway",
    "owner",
    "target_publish_date",
    "status",
    "safety",
    "sources",
    "claims",
    "seo",
    "production",
    "publication",
    "provenance",
    "history",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/content_id"
    },
    "format": {
      "enum": [
        "long-form",
        "short"
      ]
    },
    "test_item": {
      "type": "boolean",
      "description": "True only for test items (IDs 9001-9999). Test items can never be approved for release."
    },
    "working_title": {
      "type": "string",
      "minLength": 3
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "pillar": {
      "type": "string",
      "pattern": "^[PS][0-9]+$",
      "description": "P1.. for long-form pillars, S1.. for Shorts categories."
    },
    "video_type": {
      "type": "string",
      "minLength": 2
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "technical_depth"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 2
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "technical_depth": {
          "enum": [
            "basic",
            "intermediate",
            "advanced"
          ]
        }
      }
    },
    "search_intent": {
      "type": "string"
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "brands",
        "models",
        "model_years",
        "engines",
        "powertrains",
        "systems"
      ],
      "properties": {
        "scope": {
          "enum": [
            "generic",
            "specific"
          ]
        },
        "brands": {
          "$ref": "#/$defs/strings"
        },
        "models": {
          "$ref": "#/$defs/strings"
        },
        "model_years": {
          "type": "string"
        },
        "engines": {
          "$ref": "#/$defs/strings"
        },
        "powertrains": {
          "type": "array",
          "items": {
            "enum": [
              "gasoline",
              "diesel",
              "hybrid",
              "phev",
              "bev",
              "other"
            ]
          }
        },
        "systems": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "problem": {
      "type": "string"
    },
    "takeaway": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "target_publish_date": {
      "$ref": "#/$defs/optional_date"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "on_hold"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "on_hold": {
          "type": "boolean"
        },
        "hold_reason": {
          "type": "string"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flags",
        "dismissed"
      ],
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dismissed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flag",
              "rationale"
            ],
            "properties": {
              "flag": {
                "type": "string"
              },
              "rationale": {
                "type": "string",
                "minLength": 15
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_candidates",
        "recommended_title",
        "title_rationale",
        "description",
        "tags",
        "chapters",
        "thumbnail_concepts",
        "related_content"
      ],
      "properties": {
        "title_candidates": {
          "$ref": "#/$defs/strings"
        },
        "recommended_title": {
          "type": "string"
        },
        "title_rationale": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/strings"
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#\\S+$"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "title"
            ],
            "properties": {
              "time": {
                "type": "string",
                "pattern": "^([0-9]{1,2}:)?[0-9]{1,2}:[0-9]{2}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "thumbnail_concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "concept",
              "on_image_text"
            ],
            "properties": {
              "concept": {
                "type": "string",
                "minLength": 3
              },
              "on_image_text": {
                "type": "string"
              }
            }
          }
        },
        "related_content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_id"
          }
        },
        "pinned_comment": {
          "type": "string"
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets_required",
        "demo_setup",
        "footage_links",
        "runtime_exception"
      ],
      "properties": {
        "assets_required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "type",
              "status"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 2
              },
              "type": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "demo_setup": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string"
            },
            "tool_version": {
              "type": "string"
            },
            "vehicle": {
              "type": "string"
            },
            "location": {
              "type": "string"
            }
          }
        },
        "footage_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/url"
          }
        },
        "runtime_exception": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "min_seconds",
            "max_seconds",
            "rationale"
          ],
          "properties": {
            "min_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "max_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rationale": {
              "type": "string",
              "minLength": 20
            }
          }
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility_plan",
        "published_at",
        "url"
      ],
      "properties": {
        "visibility_plan": {
          "enum": [
            "",
            "public",
            "unlisted",
            "scheduled",
            "private"
          ]
        },
        "published_at": {
          "$ref": "#/$defs/optional_date"
        },
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/url"
            }
          ]
        },
        "playlist": {
          "type": "string"
        },
        "sheet_row": {
          "type": "string"
        },
        "upload_checklist": {
          "type": "array",
          "description": "Steps done in YouTube Studio during upload. Not part of the content fingerprint. All must be done before set_status.py records PUBLISHED.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "done"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 3
              },
              "done": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_record",
        "created"
      ],
      "properties": {
        "origin": {
          "enum": [
            "sheet-idea",
            "sheet-tracker",
            "manual",
            "test"
          ]
        },
        "source_record": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/content_id"
            }
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "created": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "stage",
          "by",
          "note"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "stage": {
            "$ref": "#/$defs/stage"
          },
          "on_hold": {
            "type": "boolean"
          },
          "by": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "internal_notes": {
      "type": "string"
    },
    "corrections": {
      "type": "array",
      "description": "Corrections made after publication (pinned comment, description note). Not part of the content fingerprint.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "description",
          "action",
          "by"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "action": {
            "type": "string",
            "minLength": 5
          },
          "by": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^CTK-[LS]-[0-9]{4}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "optional_date": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/date"
        }
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "enum": [
        "IDEA",
        "RESEARCH",
        "BRIEF",
        "SCRIPT",
        "TECHNICAL_REVIEW",
        "SEO",
        "PRODUCTION_PACKAGE",
        "QC",
        "APPROVED",
        "PUBLISHED",
        "PERFORMANCE_REVIEW"
      ]
    },
    "gate_result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type"
      ],
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "citation"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC[0-9]{2,3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "publisher": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "citation": {
          "type": "string",
          "minLength": 5
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "category",
        "sources",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{2,3}$"
        },
        "text": {
          "type": "string",
          "minLength": 5
        },
        "category": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SRC[0-9]{2,3}$"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "unverified",
            "verified",
            "disputed",
            "removed"
          ]
        },
        "feature_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_by": {
          "type": "string"
        },
        "verified_on": {
          "$ref": "#/$defs/optional_date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "gate_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evidence"
      ],
      "properties": {
        "result": {
          "$ref": "#/$defs/gate_result"
        },
        "evidence": {
          "type": "string"
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "reviewer",
        "reviewer_type",
        "role",
        "fingerprint",
        "gates",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{3,}$"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 2
        },
        "reviewer_type": {
          "enum": [
            "automated",
            "agent",
            "human"
          ]
        },
        "role": {
          "enum": [
            "qc",
            "technical",
            "editorial"
          ]
        },
        "qualified": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Content fingerprint the review applies to: the technical scope for role technical (brief, research, script, claims, sources, vehicle, safety), the full content for every other role."
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^G[1-8]$": {
              "$ref": "#/$defs/gate_entry"
            }
          }
        },
        "decision": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
