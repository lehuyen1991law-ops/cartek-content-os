{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lehuyen1991law-ops/cartek-content-os/schemas/normalized-data.schema.json",
  "title": "Normalized spreadsheet data (data/normalized/*.json)",
  "description": "Generated by scripts/import_sheet.py. Every record carries its source tab and cell reference.",
  "type": "object",
  "required": ["kind", "normalized_format", "generated_by", "inputs"],
  "properties": {
    "kind": { "enum": ["competitors", "personas", "channel", "taxonomy", "ideas", "tracker"] },
    "normalized_format": { "const": 1 },
    "generated_by": { "const": "scripts/import_sheet.py" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tab", "snapshot", "captured_at", "content_sha256"],
        "properties": {
          "tab": { "type": "string" },
          "snapshot": { "type": "string", "pattern": "^data/source/" },
          "captured_at": { "type": "string" },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "ideas" } } },
      "then": {
        "required": ["records"],
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "format", "group", "title", "record_type", "source"],
              "properties": {
                "id": { "type": "string", "pattern": "^CTK-[LS]-[0-9]{4}$" },
                "format": { "enum": ["long-form", "short"] },
                "group": { "type": "string", "pattern": "^[PS][0-9]+$" },
                "title": { "type": "string", "minLength": 1 },
                "record_type": { "const": "planning-idea" },
                "source": { "$ref": "#/$defs/cell_source" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "tracker" } } },
      "then": {
        "required": ["tabs", "records"],
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "format", "title", "sheet_status", "publish_date", "publish_url", "flags", "source"],
              "properties": {
                "id": { "type": "string", "pattern": "^CTK-[LS]-[0-9]{4}$" },
                "publish_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "flags": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "enum": ["competitors", "personas"] } } },
      "then": {
        "required": ["records"],
        "properties": {
          "records": {
            "type": "array",
            "items": { "type": "object", "required": ["id", "name", "source"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "taxonomy" } } },
      "then": { "required": ["pillars", "short_categories"] }
    },
    {
      "if": { "properties": { "kind": { "const": "channel" } } },
      "then": { "required": ["settings", "linked_resources"] }
    }
  ],
  "$defs": {
    "cell_source": {
      "type": "object",
      "required": ["tab", "ref"],
      "properties": {
        "tab": { "type": "string" },
        "sheet_id": { "type": ["integer", "null"] },
        "ref": { "type": "string", "pattern": "^'.+'![A-Z]+[0-9]+" }
      }
    }
  }
}
