{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lehuyen1991law-ops/cartek-content-os/schemas/production-package.schema.json",
  "title": "Cartek production package v1",
  "description": "Machine-readable handoff from Cartek Content OS to an external video production/automation system. Consumers MUST reject packages whose package_status is not APPROVED or whose test_item is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_format",
    "package_status",
    "test_item",
    "content_id",
    "format",
    "language",
    "generated",
    "delivery",
    "titles",
    "classification",
    "hook",
    "script",
    "voiceover",
    "shot_list",
    "storyboard_shots",
    "on_screen_text",
    "broll_and_animation",
    "assets",
    "demo_setup",
    "timing",
    "seo",
    "technical_claims",
    "sources",
    "safety",
    "blocking_issues"
  ],
  "properties": {
    "package_format": {
      "const": "cartek.production-package/v1"
    },
    "package_status": {
      "enum": [
        "APPROVED",
        "DRAFT_NOT_APPROVED"
      ]
    },
    "test_item": {
      "type": "boolean"
    },
    "content_id": {
      "type": "string",
      "pattern": "^CTK-[LS]-[0-9]{4}$"
    },
    "format": {
      "enum": [
        "long-form",
        "short"
      ]
    },
    "language": {
      "type": "string"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "date",
        "content_fingerprint",
        "approval_reviews"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_reviews": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "platform",
        "aspect_ratio"
      ],
      "properties": {
        "platform": {
          "const": "youtube"
        },
        "aspect_ratio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1"
          ]
        }
      }
    },
    "titles": {
      "type": "object",
      "required": [
        "working_title",
        "final_title"
      ],
      "properties": {
        "working_title": {
          "type": "string"
        },
        "final_title": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "classification": {
      "type": "object"
    },
    "hook": {
      "type": "object",
      "required": [
        "selected",
        "rationale"
      ],
      "properties": {
        "selected": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "script": {
      "type": "object",
      "required": [
        "segments"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "title",
              "narration",
              "visual",
              "on_screen_text",
              "broll",
              "safety_note",
              "claims",
              "demo_seconds",
              "estimated_start_seconds",
              "estimated_seconds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]{2,3}$"
              },
              "type": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "narration": {
                "type": "string"
              },
              "visual": {
                "type": "string"
              },
              "on_screen_text": {
                "type": "string"
              },
              "broll": {
                "type": "string"
              },
              "safety_note": {
                "type": "string"
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "demo_seconds": {
                "type": "number",
                "minimum": 0
              },
              "estimated_start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "estimated_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "voiceover": {
      "type": "object",
      "required": [
        "language",
        "full_text",
        "segments",
        "speech_rate_syllables_per_minute",
        "speech_rate_calibrated"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "full_text": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "segment_id",
              "text",
              "syllables",
              "estimated_seconds"
            ],
            "properties": {
              "segment_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "syllables": {
                "type": "integer",
                "minimum": 0
              },
              "estimated_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "speech_rate_syllables_per_minute": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speech_rate_calibrated": {
          "type": "boolean"
        }
      }
    },
    "shot_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "segment_id",
          "visual",
          "broll",
          "on_screen_text",
          "estimated_seconds"
        ],
        "properties": {
          "shot_id": {
            "type": "string"
          },
          "segment_id": {
            "type": "string"
          },
          "visual": {
            "type": "string"
          },
          "broll": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          },
          "estimated_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "storyboard_shots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "on_screen_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "text"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "broll_and_animation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "instruction"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "type",
          "status"
        ]
      }
    },
    "demo_setup": {
      "type": [
        "object",
        "null"
      ]
    },
    "timing": {
      "type": "object",
      "required": [
        "estimated_total_seconds",
        "target",
        "within_target",
        "method"
      ],
      "properties": {
        "estimated_total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "target": {
          "type": "object"
        },
        "within_target": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "object",
      "required": [
        "title",
        "description",
        "description_with_chapters",
        "tags",
        "hashtags",
        "chapters",
        "thumbnail_concepts",
        "pinned_comment"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "time",
              "title"
            ]
          }
        },
        "thumbnail_concepts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pinned_comment": {
          "type": "string"
        },
        "description_with_chapters": {
          "type": "string",
          "maxLength": 5000,
          "description": "Paste-ready description: text plus one chapter line per chapter (long-form)."
        }
      }
    },
    "technical_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "category",
          "sources",
          "status"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type"
        ]
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "flags",
        "dismissed",
        "notes"
      ],
      "properties": {
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dismissed": {
          "type": "array"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "package_status": {
            "const": "APPROVED"
          }
        }
      },
      "then": {
        "properties": {
          "test_item": {
            "const": false
          },
          "blocking_issues": {
            "maxItems": 0
          },
          "generated": {
            "properties": {
              "approval_reviews": {
                "minItems": 1
              }
            }
          },
          "technical_claims": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "verified",
                    "removed"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
